CONFIG_ARCH_X86_64=y
CONFIG_PROFILE_DEBUG=y
CONFIG_KASLR=y
CONFIG_KERNEL_CMDLINE="console=tty0 console=ttyS0"
CONFIG_SMP=y
CONFIG_MAX_CPUS=64
CONFIG_PS2=y
CONFIG_PS2_KEYBOARD=y
CONFIG_PS2_MOUSE=y
CONFIG_SERIAL=y
CONFIG_TTY=y
CONFIG_FRAMEBUFFER=y
CONFIG_PCI=y
CONFIG_BLOCK=y
CONFIG_IDE=y
CONFIG_AHCI=y
CONFIG_NVME=y
CONFIG_VFS=y
CONFIG_FAT32=y
CONFIG_EEVDF_SCHED=y
CONFIG_USER_SPACE=y
CONFIG_KSHELL=y
